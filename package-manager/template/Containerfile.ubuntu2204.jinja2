{#-
Below are imports for Bakery's macros. If any are unneeded, they can be removed.
Bakery handles bootstrapping the files into template rendering.
-#}
{%- import "apt.j2" as apt -%}
{%- import "python.j2" as python -%}
{%- import "r.j2" as r -%}

{%- if Image.Variant != "Minimal" -%}
# Build Python using uv in a separate stage
{{ python.build_stage(Dependencies.python) }}

{% endif -%}

FROM docker.io/library/ubuntu:22.04
LABEL org.opencontainers.image.base.name="docker.io/library/ubuntu:22.04"

### ARG declarations ###
ARG DEBIAN_FRONTEND=noninteractive

ENV PPM_LICENSE=""
ENV PPM_LICENSE_SERVER=""
ENV PPM_LICENSE_FILE_PATH=""
ENV PPM_STARTUP_DEBUG=0

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

### Setup environment ###
{{ apt.run_setup() }}

### Install Apt Packages ###
COPY {{ Path.Version }}/deps/ubuntu-22.04_packages.txt /tmp/packages.txt
{{ apt.run_install(files = '/tmp/packages.txt') }}

{% if not Image.Variant == "Minimal" -%}
### Install Python from previous stage ###
{{ python.copy_from_build_stage() }}

### Install Python packages ###
COPY {{ Path.Version }}/deps/python_requirements.txt /tmp/requirements.txt
{{ python.run_install_packages(Dependencies.python, requirements_file='/tmp/requirements.txt') }}

{% if Image.IsDevelopmentVersion -%}
### Install uv ###
# Package request dependency solving shells out to uv. PPM searches PATH when
# Server.PackageRequestUvPath is empty (the default), so installing into
# /usr/local/bin needs no matching PPM configuration.
#
# Pinned and checksummed rather than piped from the astral.sh install script so
# the build fails closed on a bad download. Keep the version in sync with the
# root Dockerfile of rstudio/package-manager, which is the uv that PPM's own CI
# tests against.
#
# Named UV_RELEASE_VERSION, not UV_VERSION: uv itself consumes a large set of
# UV_* variables, so a distinct name avoids any collision at build time.
#
# Development images only, while package requests sit behind the
# `package_requests` feature flag. Drop the IsDevelopmentVersion guard when the
# feature reaches GA so released images carry uv too.
ARG UV_RELEASE_VERSION=0.12.3
ARG UV_SHA256_X86=600cf9a742aca00d292673b16b5acffaa7b8c269a364ad0c2e79498dcb1fe101
ARG UV_SHA256_ARM=bb66cb52e7b1823aed1183630d8d8e5c958840d584a4c55ec10a4cfc168dcca2
RUN ARCH="$(dpkg --print-architecture)" && \
    case "$ARCH" in \
        amd64) UV_TARGET="x86_64-unknown-linux-gnu"; SHA256="$UV_SHA256_X86" ;; \
        arm64) UV_TARGET="aarch64-unknown-linux-gnu"; SHA256="$UV_SHA256_ARM" ;; \
        *) echo >&2 "unsupported architecture: $ARCH"; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_RELEASE_VERSION}/uv-${UV_TARGET}.tar.gz" -o /tmp/uv.tar.gz && \
    echo "${SHA256} */tmp/uv.tar.gz" | sha256sum -c - && \
    tar -C /usr/local/bin --strip-components=1 -xzf /tmp/uv.tar.gz "uv-${UV_TARGET}/uv" "uv-${UV_TARGET}/uvx" && \
    rm -f /tmp/uv.tar.gz && \
    uv --version

### Put Python on PATH for uv ###
# uv resolves a dependency closure only when it finds a Python interpreter.
# PPM runs uv with UV_PYTHON_DOWNLOADS=never, so uv cannot download one, and
# this image has none on PATH: the interpreter from the build stage sits under
# /opt/python and nothing points at it. Every resolve then fails with `No
# interpreter found`, and /__api__/package-requests/resolve-deps answers 500.
#
# PPM passes PATH, HOME, and the proxy and certificate variables to uv and
# drops every other variable, including UV_PYTHON_INSTALL_DIR, so PATH is the
# way to give uv an interpreter.
#
# PATH rather than a symlink into /usr/local/bin: the root Dockerfile of
# rstudio/package-manager adds the same PATH entry, and records that
# symlinking `python` and `python3` breaks Python Git sandboxing.
#
# The interpreter version does not have to match the version that PPM resolves
# for. `uv pip compile --python-version 3.12` needs any interpreter, and it
# gives the same closure under 3.9, 3.12, and 3.14.
#
# Development images only, for the reason above. Drop the IsDevelopmentVersion
# guard with the uv guard at GA.
ENV PATH={{ python.get_version_directory(Dependencies.python.0) }}/bin:$PATH

{% endif -%}
### Install R ###
{{ r.run_install(Dependencies.R) }}
{%- endif %}

### Install Package Manager {{ Image.Version }} ###
ARG PACKAGE_MANAGER_VERSION="{{ Image.Version }}"
COPY --chmod=0755 {{ Path.Version }}/scripts/install_package_manager.sh /tmp/install_package_manager.sh
RUN {% if Image.Variant != "Minimal" %}PYTHON_VERSION={{ Dependencies.python.0 }} R_VERSION={{ Dependencies.R.0 }} {% endif %}{% if Image.DownloadURL is defined %}DOWNLOAD_URL="{{ Image.DownloadURL }}" {% endif %}\
    /tmp/install_package_manager.sh \
    && rm -f /tmp/install_package_manager.sh

### Add startup.sh script ###
COPY --chmod=0775 {{ Path.Version }}/scripts/startup.sh /usr/local/bin/startup.sh
RUN mkdir -p /var/run/rstudio-pm \
    && chmod +x /usr/local/bin/startup.sh \
    && chown rstudio-pm:rstudio-pm /usr/local/bin/startup.sh \
    && chown -R rstudio-pm:rstudio-pm /var/run/rstudio-pm

USER rstudio-pm

RUN echo "source <(rspm completion bash)" >> ~/.bashrc

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:4242/__ping__ || exit 1

CMD ["/usr/local/bin/startup.sh"]
