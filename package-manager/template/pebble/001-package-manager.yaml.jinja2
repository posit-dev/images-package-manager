services:
  package-manager:
    override: replace
    command: /usr/local/bin/startup.sh
    startup: enabled
    # Pebble exits when the service does, so the container follows PPM's lifecycle.
    on-success: shutdown
    on-failure: shutdown
    # Time for PPM to stop and deactivate its license after SIGTERM, before
    # SIGKILL. Kept under the recommended 120s stop timeout; the outer
    # Docker/Kubernetes timeout still wins if it is shorter.
    kill-delay: 110s
